# OpenF1 API Credentials
OPENF1_USERNAME=your_username_here
OPENF1_PASSWORD=your_password_here

# MongoDB Connection String (if running outside Docker)
MONGO_URI=mongodb://localhost:27017/stratos

# Configs
LIVE_DECISION_THROTTLE_SECONDS=30

# CORS Configuration
# Comma-separated list of allowed origins (no wildcard * when credentials are used)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Frontend API Configuration
# Local development defaults (Production should point to the Render backend domain)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
